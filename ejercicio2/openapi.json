{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Cursos Universitarios",
    "version": "1.0.0"
  },
  "paths": {
    "/cursos": {
      "get": {
        "summary": "Consultar cursos",
        "responses": {
          "200": {
            "description": "Lista de cursos obtenida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Curso"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear curso",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CursoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Curso creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Curso"
                }
              }
            }
          }
        }
      }
    },
    "/cursos/{codigo}": {
      "get": {
        "summary": "Consultar curso por codigo",
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Curso encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Curso"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado"
          }
        }
      }
    },
    "/cursos/id/{id}": {
      "put": {
        "summary": "Actualizar curso",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CursoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curso actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Curso"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado"
          }
        }
      },
      "delete": {
        "summary": "Eliminar curso",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Curso eliminado"
          },
          "404": {
            "description": "Curso no encontrado"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Curso": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nombre": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "creditos": {
            "type": "integer"
          },
          "estado": {
            "type": "string"
          }
        }
      },
      "CursoInput": {
        "type": "object",
        "required": [
          "nombre",
          "codigo",
          "creditos",
          "estado"
        ],
        "properties": {
          "nombre": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "creditos": {
            "type": "integer"
          },
          "estado": {
            "type": "string"
          }
        }
      }
    }
  }
}
